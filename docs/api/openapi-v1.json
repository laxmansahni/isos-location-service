{
  "openapi": "3.1.1",
  "info": {
    "title": "ISOS.LocationService | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/locationtracking/points": {
      "post": {
        "tags": [
          "LocationTracking"
        ],
        "summary": "Submits 1 to 100 location points from the Assistance App.",
        "description": "Returns 200 with a per-point result. The device deletes points reported as Stored, Duplicate or\nRejected (LLD 4.1). A batch that is empty, too large or has no device id is rejected as a whole with 400.",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitPointsRequest"
              }
            },
            "text/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitPointsRequest"
              }
            },
            "application/*+json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitPointsRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitPointsResponse"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitPointsResponse"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitPointsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "text/plain": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "DeviceDto": {
        "required": [
          "id",
          "platform",
          "appVersion",
          "timezone"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "null",
              "string"
            ]
          },
          "platform": {
            "type": [
              "null",
              "string"
            ]
          },
          "appVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "timezone": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PointDto": {
        "required": [
          "pointId",
          "capturedAt",
          "utcOffsetMinutes",
          "latitude",
          "longitude",
          "accuracy",
          "speed",
          "course",
          "altitude",
          "mockLocation",
          "shared"
        ],
        "type": "object",
        "properties": {
          "pointId": {
            "type": [
              "null",
              "string"
            ],
            "description": "Generated on the device. With the party and capture time it makes a retry idempotent.",
            "format": "uuid"
          },
          "capturedAt": {
            "type": [
              "null",
              "string"
            ],
            "description": "When the device captured the point (not when it was uploaded).",
            "format": "date-time"
          },
          "utcOffsetMinutes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "Local time offset from UTC at capture, in minutes (India is 330). Used for schedule rules.",
            "format": "int32"
          },
          "latitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Degrees, -90 to 90.",
            "format": "double"
          },
          "longitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Degrees, -180 to 180.",
            "format": "double"
          },
          "accuracy": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Horizontal accuracy in metres.",
            "format": "double"
          },
          "speed": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Ground speed in metres per second. Omit when unknown.",
            "format": "double"
          },
          "course": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Direction of travel in degrees clockwise from true north (0 = north, 90 = east), 0 to 360. Omit when unknown or stationary.",
            "format": "double"
          },
          "altitude": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "description": "Metres above sea level. Optional.",
            "format": "double"
          },
          "mockLocation": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "True when the OS reports a simulated location. Stored as a quality flag."
          },
          "shared": {
            "type": [
              "null",
              "boolean"
            ],
            "description": "Required. True when live location sharing is on for this point: it is added to the history\n    managers can see and becomes the latest position. False when the point was captured only for AEC or Location\n    Based Alerts (\"not shared\"): it is never added to history and only replaces the latest position when it is newer."
          }
        }
      },
      "PointResult": {
        "required": [
          "pointId",
          "status",
          "reason"
        ],
        "type": "object",
        "properties": {
          "pointId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "status": {
            "$ref": "#/components/schemas/PointStatus"
          },
          "reason": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "PointStatus": {
        "enum": [
          "Stored",
          "Duplicate",
          "Superseded",
          "Rejected"
        ],
        "description": "Stored: accepted. Duplicate: the same point was already stored. Superseded: a not-shared point that is not newer\nthan the latest position, so it was dropped. Rejected: invalid. The device may delete a point in every status."
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "SubmitPointsRequest": {
        "required": [
          "points",
          "device"
        ],
        "type": "object",
        "properties": {
          "points": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "$ref": "#/components/schemas/PointDto"
            }
          },
          "device": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/DeviceDto"
              }
            ]
          }
        }
      },
      "SubmitPointsResponse": {
        "required": [
          "stored",
          "duplicates",
          "superseded",
          "rejected",
          "results"
        ],
        "type": "object",
        "properties": {
          "stored": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "duplicates": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "superseded": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rejected": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "results": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PointResult"
            }
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "LocationTracking"
    }
  ]
}
